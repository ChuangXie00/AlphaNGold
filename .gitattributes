# Automatically recognize text files and normalize line endings in Git
* text=auto

# Source code and configuration files use LF
*.java       text eol=lf
*.py         text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.properties text eol=lf
*.sql        text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.md         text eol=lf

# Unix scripts and Maven Wrapper use LF
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files must not be modified as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.jar  binary